{
  "manifest_version": 3,
  "name": "Aprion Password Manager",
  "version": "0.5.0",
  "description": "A private, local vault and account picker for the website you're on.",
  "minimum_chrome_version": "121",
  "browser_specific_settings": {
    "gecko": {
      "id": "aprion-password-manager@localciggyshop.github.io",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": ["none"]
      }
    },
    "safari": {
      "strict_min_version": "17.0"
    }
  },
  "permissions": ["storage", "scripting", "activeTab", "alarms"],
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["capture.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://accounts.google.com/*",
        "https://login.microsoftonline.com/*",
        "https://login.live.com/*"
      ],
      "js": ["provider-chooser.js"],
      "run_at": "document_idle"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "scripts": ["background.js"],
    "type": "module"
  },
  "action": {
    "default_title": "Aprion \u00b7 Site accounts",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_ui": {
    "page": "vault.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "incognito": "not_allowed"
}
