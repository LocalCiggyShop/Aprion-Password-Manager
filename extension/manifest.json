{
  "manifest_version": 3,
  "name": "Aprion Password Manager",
  "version": "0.1.0",
  "description": "A private, local vault and account picker for the website you're on.",
  "minimum_chrome_version": "116",
  "permissions": ["storage", "scripting", "activeTab", "alarms"],
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["capture.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Aprion \u00b7 Site accounts",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png",
      "48": "icons/48.png",
      "128": "icons/128.png"
    }
  },
  "options_page": "vault.html",
  "icons": {
    "16": "icons/16.png",
    "32": "icons/32.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  },
  "incognito": "not_allowed"
}
